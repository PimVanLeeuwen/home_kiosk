# Copy to sdkconfig.secrets (git-ignored) and fill in. CI writes the same file
# with only the hub address, from the PANEL_HUB_URL secret: the boards keep the
# Wi-Fi details from their first USB flash.
CONFIG_PANEL_HUB_URL="http://<the hub's LAN IP>:8083"
CONFIG_PANEL_WIFI_SSID="your-network"
CONFIG_PANEL_WIFI_PASSWORD="your-password"
