# Waveshare ESP32-P4-WIFI6-Touch-LCD-4B: 720 x 720 MIPI DSI, GT911, 32 MB flash
# and PSRAM, Wi-Fi through the ESP32-C6 over SDIO. From Waveshare's shared
# defaults and its lvgl-v9 and wifi-station examples (2026-08), ESP-IDF v5.5.
CONFIG_IDF_TARGET="esp32p4"
# Chip revision: our boards have an ESP32-P4 v1.3 (esptool, 2026-10-19), while
# Waveshare's defaults assume v3.x. Builds for v1.x and v3.x do not run on each
# other, so every panel must have a v1.x chip (check with esptool flash-id).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_SPIRAM=y
# 250 MHz is for v3.x chips only.
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y

# Display, in 24-bit colour: in 16-bit the soft glows show visible bands.
CONFIG_BSP_LCD_TYPE_720_720_4_INCH=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB888=y
CONFIG_LV_COLOR_DEPTH_24=y
# A faster console, for screenshots (panels/tools/shot.py) and logs. The speed can
# only be set on a custom console UART: UART0 on the board's CH343 pins (TX 37,
# RX 38). The boot ROM still logs its first lines at 115200.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=37
CONFIG_ESP_CONSOLE_UART_RX_GPIO=38
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Wi-Fi through the ESP32-C6 (ESP-Hosted over SDIO); the C6 keeps its factory image.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# The C6's factory ESP-Hosted image is old (it reports 0.0.0): the SDIO link failed
# on a few-kB answer at the defaults (streaming receive, 40 MHz). The conservative
# settings, as speed hardly matters for a panel.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_NONE=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=20000
