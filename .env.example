# Copy to .env next to docker-compose.yml on the NAS. Never commit the real file.

# Ghostfolio account security token (M3). Settings -> your account -> Security token.
GHOSTFOLIO_TOKEN=

# Twelve Data API key for the spotlight price history (M4).
TWELVEDATA_API_KEY=

# Readeck API token for Save to Readeck and the Saved page.
# Create under Readeck -> Profile -> API tokens, with bookmarks:read and bookmarks:write.
READECK_TOKEN=

# Ghostfolio (M3). Generate the secrets with: openssl rand -hex 32
GHOSTFOLIO_DB_PASSWORD=
GHOSTFOLIO_REDIS_PASSWORD=
GHOSTFOLIO_ACCESS_TOKEN_SALT=
GHOSTFOLIO_JWT_SECRET=

# Live stats on service tiles (Home hub). Each key comes from the app itself.
# Jellyfin: Dashboard -> API Keys -> +
JELLYFIN_API_KEY=
# Immich: Account Settings -> API Keys, with the server.statistics permission
# (the key of an admin account).
IMMICH_API_KEY=
# Jellyseerr: Settings -> General -> API Key
JELLYSEERR_API_KEY=
# Sonarr, Radarr, Bazarr, Prowlarr: Settings -> General -> API Key
SONARR_API_KEY=
RADARR_API_KEY=
BAZARR_API_KEY=
PROWLARR_API_KEY=
# SABnzbd: Config -> General -> API Key. Transmission needs no key (no RPC auth).
SABNZBD_API_KEY=
# Tracearr (Media page: watch stats, library): Settings > Data & API > API, trr_pub_...
TRACEARR_API_KEY=
# Paperless-ngx: your profile (top right) -> API Auth Token -> Create; read-only use
# (the Documents, Inbox and Correspondents figures on its tile).
PAPERLESS_API_KEY=
# AdGuard Home: the password of its "hub" user, a user of its own for the hub
# (AdGuard has no read-only users; nas-docker README, AdGuard Home). Queries and
# blocked counts on its tile and the Home card, never per device.
ADGUARD_API_KEY=
# Anthropic (plan.md M26): the owner's API key (console.anthropic.com -> API keys),
# in a workspace with a monthly spend limit a little above the hub's EUR 5 cap.
# Empty: no AI at all.
ANTHROPIC_API_KEY=

# Repos page: fine-grained GitHub tokens, read-only (github.com -> Settings ->
# Developer settings -> Fine-grained tokens). Repository permissions, all
# read-only: Metadata, Contents, Pull requests, Issues, Actions, Commit statuses.
# A token covers one owner: GITHUB_TOKEN for PimVanLeeuwen (also reads every
# public repo, such as GEWIS), GITHUB_TOKEN_HUBBLE for Hubble-Community-Cafe.
# The same tokens make the nightly GitHub mirror, so give them access to ALL of
# the owner's repositories, or the rest is silently not backed up.
GITHUB_TOKEN=
GITHUB_TOKEN_HUBBLE=

# Exposure audit (NAS page): a Cloudflare API token, read-only. dash.cloudflare.com
# -> My Profile -> API Tokens -> Create Custom Token: Zone / DNS / Read and
# Account / Cloudflare Tunnel / Read, for your own zone only.
CLOUDFLARE_API_TOKEN=

# The morning train (Home card, Telegram on problems): apiportal.ns.nl -> sign up ->
# Products -> Ns-App -> subscribe; the primary key of the subscription.
NS_API_KEY=

# Today's calendar: your Apple ID and an app-specific password for it
# (account.apple.com > Sign-In and Security > App-Specific Passwords). It can read
# iCloud mail and contacts too, so keep it NAS-only; revoke it there any time.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# Laundry: a ConnectLife account of its own (not Sign in with Apple), with the
# washer and dryer shared to it from the ConnectLife app.
CONNECTLIFE_USERNAME=
CONNECTLIFE_PASSWORD=

# Lights: the Hue Bridge application key, made once with its link button.
HUE_APPLICATION_KEY=

# Music: the Client ID of the Spotify developer app (Web API, redirect URI
# https://<nas>.<tailnet>.ts.net/api/music/callback). No client secret: PKCE.
SPOTIFY_CLIENT_ID=
# Companion credentials of the living room Apple TV, from a one-time PIN pairing:
# lets the hub switch it on and open Spotify to start a favourite there.
APPLE_TV_LIVING_ROOM_COMPANION=

# Apple devices: AirPlay credentials of the Bedroom Apple TV, from a one-time PIN
# pairing (pyatv). Lets the hub read what that TV plays; empty: online state only.
APPLE_TV_BEDROOM_CREDENTIALS=

# Telegram (Alerts): the hub is the one sender. The bot token from BotFather;
# chat ids from the bot's getUpdates (group ids start with -).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_NAS=
TELEGRAM_CHAT_PORTFOLIO=
# Shared key senders on the NAS (backup.sh, Watchtower, Uptime Kuma) send as
# the X-Notify-Key header to /api/notify. Generate with: openssl rand -hex 32
NOTIFY_KEY=
