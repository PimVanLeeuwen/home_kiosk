# Copy to .env next to docker-compose.yml on the NAS. Never commit the real file.

# Ghostfolio account security token (M3). Settings -> your account -> Security token.
GHOSTFOLIO_TOKEN=

# Twelve Data API key for the spotlight price history (M4).
TWELVEDATA_API_KEY=

# Readeck API token for Save to Readeck and the Saved page.
# Create under Readeck -> Profile -> API tokens, with bookmarks:read and bookmarks:write.
READECK_TOKEN=

# Ghostfolio (M3). Generate the secrets with: openssl rand -hex 32
GHOSTFOLIO_DB_PASSWORD=
GHOSTFOLIO_REDIS_PASSWORD=
GHOSTFOLIO_ACCESS_TOKEN_SALT=
GHOSTFOLIO_JWT_SECRET=

# Live stats on service tiles (Home hub). Each key comes from the app itself.
# Jellyfin: Dashboard -> API Keys -> +
JELLYFIN_API_KEY=
# Immich: Account Settings -> API Keys, with the server.statistics permission
# (the key of an admin account).
IMMICH_API_KEY=
# Jellyseerr: Settings -> General -> API Key
JELLYSEERR_API_KEY=
# Sonarr, Radarr, Bazarr, Prowlarr: Settings -> General -> API Key
SONARR_API_KEY=
RADARR_API_KEY=
BAZARR_API_KEY=
PROWLARR_API_KEY=
# SABnzbd: Config -> General -> API Key. Transmission needs no key (no RPC auth).
SABNZBD_API_KEY=

# Repos page: fine-grained GitHub tokens, read-only (github.com -> Settings ->
# Developer settings -> Fine-grained tokens). Repository permissions, all
# read-only: Metadata, Contents, Pull requests, Issues, Actions, Commit statuses.
# A token covers one owner: GITHUB_TOKEN for PimVanLeeuwen (also reads every
# public repo, such as GEWIS), GITHUB_TOKEN_HUBBLE for Hubble-Community-Cafe.
# The same tokens make the nightly GitHub mirror, so give them access to ALL of
# the owner's repositories, or the rest is silently not backed up.
GITHUB_TOKEN=
GITHUB_TOKEN_HUBBLE=

# Exposure audit (NAS page): a Cloudflare API token, read-only. dash.cloudflare.com
# -> My Profile -> API Tokens -> Create Custom Token: Zone / DNS / Read and
# Account / Cloudflare Tunnel / Read, for the example.com zone only.
CLOUDFLARE_API_TOKEN=

# The morning train (Home card, Telegram on problems): apiportal.ns.nl -> sign up ->
# Products -> Ns-App -> subscribe; the primary key of the subscription.
NS_API_KEY=

# Telegram (Alerts): the hub is the one sender. The bot token from BotFather;
# chat ids from the bot's getUpdates (group ids start with -).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_NAS=
TELEGRAM_CHAT_PORTFOLIO=
# Shared key senders on the NAS (backup.sh, Watchtower, Uptime Kuma) send as
# the X-Notify-Key header to /api/notify. Generate with: openssl rand -hex 32
NOTIFY_KEY=
